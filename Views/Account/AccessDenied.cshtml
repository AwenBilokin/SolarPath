@{
    ViewData["Title"] = "Доступ заборонено";
}

<div class="container py-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="mb-4" style="font-size:4rem;">🔒</div>
      <h1 class="fw-bold mb-2">Доступ заборонено</h1>
      <p class="text-muted mb-4">У вас немає прав для перегляду цієї сторінки.<br>Будь ласка, увійдіть з відповідним обліковим записом.</p>
      <div class="d-flex gap-2 justify-content-center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">На головну</a>
