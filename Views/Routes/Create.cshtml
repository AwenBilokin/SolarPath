@model SolarPath.Web.Models.Route
@{ViewData["Title"] = "Створити маршрут";}

<h2 class="mb-4 fw-bold"><i class="bi bi-plus-circle-fill me-2 text-success"></i>Новий маршрут</h2>

<div class="card shadow p-4">
<form asp-action="Create" method="post" enctype="multipart/form-data" id="routeForm">
  @Html.AntiForgeryToken()
  <div class="row g-3">
    <div class="col-md-8">
      <label class="form-label fw-semibold">Назва</label>
      <input asp-for="Title" class="form-control" required/>
    </div>
    <div class="col-md-4">
      <label class="form-label fw-semibold">Категорія</label>
      <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"><option value="">— Оберіть —</option></select>
    </div>
    <div class="col-12">
      <label class="form-label fw-semibold">Опис</label>
      <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
    </div>
    <div class="col-md-3">
      <label class="form-label fw-semibold">Складність</label>
      <select asp-for="Difficulty" class="form-select" asp-items="Html.GetEnumSelectList<SolarPath.Web.Models.DifficultyLevel>()"></select>
    </div>
    <div class="col-md-3">
      <label class="form-label fw-semibold">Відстань (км)</label>
      <input asp-for="DistanceKm" type="number" step="0.1" class="form-control"/>
    </div>
    <div class="col-md-3">
      <label class="form-label fw-semibold">Тривалість (хв)</label>
      <input asp-for="DurationMinutes" type="number" class="form-control"/>
    </div>
    <div class="col-md-3">
      <label class="form-label fw-semibold">Макс. учасників</label>
      <input asp-for="MaxParticipants" type="number" class="form-control"/>
    </div>
    <div class="col-md-3">
      <label class="form-label fw-semibold">Ціна/особу (₴)</label>
      <input asp-for="PricePerPerson" type="number" step="0.01" class="form-control"/>
    </div>
    <div class="col-md-3">
      <label class="form-label fw-semibold">Сезон (початок)</label>
      <input asp-for="SeasonStart" type="date" class="form-control"/>
    </div>
    <div class="col-md-3">
      <label class="form-label fw-semibold">Сезон (кінець)</label>
      <input asp-for="SeasonEnd" type="date" class="form-control"/>
    </div>
    <div class="col-md-3">
      <label class="form-label fw-semibold">Фото маршруту</label>
      <input type="file" name="image" class="form-control" accept="image/*"/>
    </div>

    {{!-- ── РЕДАКТОР ТОЧОК МАРШРУТУ ──────────────────────────────── --}}
    <div class="col-12">
      <label class="form-label fw-semibold">Точки маршруту</label>
      <p class="text-muted small mb-2">
        <i class="bi bi-info-circle me-1"></i>
        Клікніть на карту, щоб додати точку. Або введіть координати вручну нижче.
      </p>

      {{!-- мінікарта для вибору точок --}}
      <div id="pointPicker" style="height:380px;border-radius:10px;overflow:hidden;border:1px solid #dee2e6;" class="mb-3"></div>

      {{!-- список доданих точок --}}
      <div id="pointsList" class="mb-2"></div>

      {{!-- форма ручного додавання --}}
      <div class="card bg-light p-3 mb-2">
        <div class="row g-2 align-items-end">
          <div class="col-md-3">
            <label class="form-label small mb-1">Назва точки</label>
            <input type="text" id="pt-title" class="form-control form-control-sm" placeholder="напр. Старт — Яремче"/>
          </div>
          <div class="col-md-2">
            <label class="form-label small mb-1">Широта</label>
            <input type="number" id="pt-lat" step="0.000001" class="form-control form-control-sm" placeholder="48.4568"/>
          </div>
          <div class="col-md-2">
            <label class="form-label small mb-1">Довгота</label>
            <input type="number" id="pt-lng" step="0.000001" class="form-control form-control-sm" placeholder="24.5536"/>
          </div>
          <div class="col-md-3">
            <label class="form-label small mb-1">Тип</label>
            <select id="pt-type" class="form-select form-select-sm">
              <option value="Start">Старт</option>
              <option value="Checkpoint">Проміжна точка</option>
              <option value="Highlight">Визначна пам'ятка</option>
              <option value="Finish">Фініш</option>
            </select>
          </div>
          <div class="col-md-2">
            <button type="button" class="btn btn-sm btn-success w-100" onclick="addPointManual()">
              <i class="bi bi-plus-lg"></i> Додати
            </button>
          </div>
        </div>
      </div>

      {{!-- приховані поля, що відправляться на сервер --}}
      <div id="hiddenPoints"></div>
    </div>

    <div class="col-12 d-flex gap-2">
      <button type="submit" class="btn btn-success px-4"><i class="bi bi-check2-circle me-2"></i>Зберегти</button>
      <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
    </div>
  </div>
</form>
</div>

@section Scripts {
<script>
var map = L.map('pointPicker').setView([48.5, 31.2], 6);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap'}).addTo(map);

var points = [];
var markers = [];
var routeLine = null;

// Клік по карті → додає точку з авто-типом
map.on('click', function(e) {
  var nextType = points.length === 0 ? 'Start'
               : 'Checkpoint';
  addPoint({
    lat: e.latlng.lat.toFixed(6),
    lng: e.latlng.lng.toFixed(6),
    title: nextType === 'Start' ? 'Старт' : 'Точка ' + (points.length + 1),
    type: nextType
  });
});

function addPointManual() {
  var lat = parseFloat(document.getElementById('pt-lat').value);
  var lng = parseFloat(document.getElementById('pt-lng').value);
  var title = document.getElementById('pt-title').value.trim();
  var type = document.getElementById('pt-type').value;
  if (isNaN(lat) || isNaN(lng)) { alert('Введіть коректні координати'); return; }
  addPoint({ lat: lat.toFixed(6), lng: lng.toFixed(6), title: title || type, type });
  document.getElementById('pt-lat').value = '';
  document.getElementById('pt-lng').value = '';
  document.getElementById('pt-title').value = '';
}

function addPoint(pt) {
  var idx = points.length;
  points.push(pt);

  var color = pt.type === 'Start' ? '#16a34a' : pt.type === 'Finish' ? '#dc2626' : '#2563eb';
  var icon = L.divIcon({
    html: '<div style="width:14px;height:14px;border-radius:50%;background:'+color+';border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4);"></div>',
    iconSize:[14,14], iconAnchor:[7,7], className:''
  });
  var marker = L.marker([pt.lat, pt.lng], {icon})
    .bindPopup('<b>'+pt.title+'</b><br><small>'+pt.type+'</small>')
    .addTo(map);
  markers.push(marker);

  renderPointsList();
  renderHiddenFields();
  updateMapLine();
  map.setView([pt.lat, pt.lng], Math.max(map.getZoom(), 12));
}

function removePoint(idx) {
  points.splice(idx, 1);
  map.removeLayer(markers[idx]);
  markers.splice(idx, 1);
  renderPointsList();
  renderHiddenFields();
  updateMapLine();
}

var typeLabels = {Start:'Старт', Checkpoint:'Проміжна', Highlight:"Пам'ятка", Finish:'Фініш'};
var typeColors = {Start:'success', Checkpoint:'primary', Highlight:'warning', Finish:'danger'};

function renderPointsList() {
  var html = points.map(function(pt, i) {
    return '<div class="d-flex align-items-center gap-2 mb-1 p-2 bg-light rounded">' +
      '<span class="badge bg-'+typeColors[pt.type]+' text-nowrap">'+typeLabels[pt.type]+'</span>' +
      '<span class="flex-grow-1 small fw-semibold">'+pt.title+'</span>' +
      '<span class="text-muted small font-monospace">'+pt.lat+', '+pt.lng+'</span>' +
      '<button type="button" class="btn btn-outline-danger btn-sm py-0 px-1" onclick="removePoint('+i+')" title="Видалити"><i class="bi bi-trash"></i></button>' +
    '</div>';
  }).join('');
  document.getElementById('pointsList').innerHTML = html || '<p class="text-muted small">Ще немає точок. Клікніть на карту або введіть вручну.</p>';
}

function renderHiddenFields() {
  var html = points.map(function(pt, i) {
    return '<input type="hidden" name="Points['+i+'].Latitude" value="'+pt.lat+'">'+
           '<input type="hidden" name="Points['+i+'].Longitude" value="'+pt.lng+'">'+
           '<input type="hidden" name="Points['+i+'].Title" value="'+pt.title+'">'+
           '<input type="hidden" name="Points['+i+'].PointType" value="'+pt.type+'">'+
           '<input type="hidden" name="Points['+i+'].OrderIndex" value="'+i+'">';
  }).join('');
  document.getElementById('hiddenPoints').innerHTML = html;
}

function updateMapLine() {
  if (routeLine) map.removeLayer(routeLine);
  if (points.length < 2) return;
  var latlngs = points.map(p => [p.lat, p.lng]);
  routeLine = L.polyline(latlngs, {color:'#16a34a', weight:3, dashArray:'6 6', opacity:.7}).addTo(map);
}

renderPointsList();
</script>
}
